+/*
+ * Render-pass worker (pass_worker.c, Windows): a second copy of the
+ * executable runs headless on another core as a helper process. The main
+ * process submits a machine state (main RAM, scratchpad, CPU and GTE
+ * registers) and an opaque job; the helper loads it, runs the title's job
+ * function with guest time frozen, and hands back what the job changed: the
+ * RAM pages that differ, the scratchpad, and the PGXP shadows it wrote. Inside
+ * a pass in the main process, psx_mod_pass_worker_apply puts those on top of
+ * the same state; the pass then submits the result to the GPU.
+ *
+ * The job function is registered in both processes (a constructor); in the
+ * helper it runs with g_psx_render_pass_active set, like a pass. Only one job
+ * is out at a time. Every call returns 0 when the worker is unavailable
+ * (another platform, a session with more than 2 MiB of RAM, the helper
+ * exited); the title then runs its passes in-process.
+ */
+typedef int (*PSXModPassWorkerJob)(struct CPUState* cpu, const void* user,
+                                   uint32_t len);
+typedef struct PSXModPassWorkerState {
+    const uint8_t* ram;          /* psx_ram_live_bytes() bytes */
+    const uint8_t* scratchpad;   /* 1024 bytes */
+    const uint32_t* gpr;         /* 32 */
+    uint32_t hi, lo;
+    const uint32_t* gte_data;    /* 32 */
+    const uint32_t* gte_ctrl;    /* 32 */
+} PSXModPassWorkerState;
+typedef struct PSXModPassWorkerStats {
+    uint64_t submitted, done, late, failed;
+    double last_job_ms;
+    uint32_t last_pages, last_pgxp;
+    int running, failed_session;
+} PSXModPassWorkerStats;
+int psx_mod_pass_worker_set_job(PSXModPassWorkerJob job);
+int psx_mod_pass_worker_is_helper(void);
+int psx_mod_pass_worker_start(void);
+int psx_mod_pass_worker_submit(const PSXModPassWorkerState* state,
+                               const void* user, uint32_t len);
+/* 1 when the job is done and its result kept, waiting up to wait_ms. */
+int psx_mod_pass_worker_result(uint32_t wait_ms);
+int psx_mod_pass_worker_pending(void);
+int psx_mod_pass_worker_apply(void);
+void psx_mod_pass_worker_get_stats(PSXModPassWorkerStats* out);
