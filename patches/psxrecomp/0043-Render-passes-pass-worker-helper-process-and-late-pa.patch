--- a/runtime/src/pgxp.cpp
+++ b/runtime/src/pgxp.cpp
@@ -474,6 +474,43 @@ extern "C" void pgxp_checkpoint_rollback(void) {
     }
 }
 
+/* Render-pass helper process (pass_worker.c): the shadows a pass in the
+ * helper wrote, carried to the main process. Export lists every RAM /
+ * scratchpad slot the open checkpoint journaled, as its shadow index and
+ * current value (gen 1 = live there, 0 = dead). Import writes them into this
+ * process's shadows through the journal, so the enclosing pass rolls them back
+ * like shadows its own guest code wrote. Returns UINT32_MAX when the slots do
+ * not fit in cap. */
+extern "C" uint32_t pgxp_value_size(void) { return (uint32_t)sizeof(PGXPValue); }
+
+extern "C" uint32_t pgxp_pass_export(uint32_t *index, void *values, uint32_t cap) {
+    PGXPValue *out = (PGXPValue *)values;
+    if (s_ck_depth == 0 || s_ck_lossy) return UINT32_MAX;
+    if (s_ck_n > cap) return UINT32_MAX;
+    for (size_t i = 0; i < s_ck_n; i++) {
+        const PGXPValue *pv = s_ck_log[i].slot;
+        index[i] = (uint32_t)ck_index(pv);
+        out[i] = *pv;
+        out[i].gen = pv->gen == s_gen ? 1u : 0u;
+    }
+    return (uint32_t)s_ck_n;
+}
+
+extern "C" void pgxp_pass_import(const uint32_t *index, const void *values, uint32_t n) {
+    const PGXPValue *in = (const PGXPValue *)values;
+    if (!s_ram) return;
+    for (uint32_t i = 0; i < n; i++) {
+        PGXPValue *pv;
+        if (index[i] < PGXP_SHADOW_WORDS) pv = &s_ram[index[i]];
+        else if (index[i] - PGXP_SHADOW_WORDS < PGXP_SCRATCH_WORDS)
+            pv = &s_scratch[index[i] - PGXP_SHADOW_WORDS];
+        else continue;
+        ck_note(pv);
+        *pv = in[i];
+        pv->gen = in[i].gen ? s_gen : 0u;
+    }
+}
+
 PGXP_HOT int pv_live(const PGXPValue *pv) {
     return pv && pv->gen == s_gen && (pv->flags & PGXP_F_VXY) != 0;
 }
