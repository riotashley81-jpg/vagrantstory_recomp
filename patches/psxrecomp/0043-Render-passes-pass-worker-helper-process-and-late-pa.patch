+/* Render-pass worker (mod_plugins.h psx_mod_pass_worker_*).
+ *
+ * A render pass re-runs guest draw code on the emulation thread, between the
+ * game's own frames: the two take turns on one core. The runtime cannot run a
+ * second machine on another thread of the same process (generated code and
+ * the devices live in globals), so a second copy of the executable runs as a
+ * helper process, headless, with no game of its own. Per job the main process
+ * hands it a machine state (main RAM, scratchpad, CPU and GTE registers) and
+ * an opaque job description; the helper loads the state, runs the title's job
+ * function with guest time frozen, as a pass would, and hands back what the
+ * job changed: the 4 KiB RAM pages that differ, the scratchpad and the PGXP
+ * shadows it wrote. Inside a pass the main process puts those on top of the
+ * same state and submits the result to its GPU, which costs a fraction of
+ * running the draw code. The helper works while the main thread runs the
+ * game, on another core.
+ *
+ * Shared memory and events are Windows objects; elsewhere every entry point
+ * reports "unavailable" and titles keep their in-process passes. */
+#include "mod_plugins.h"
+#include "cpu_state.h"
+#include "psx_memory.h"
+#include "psx_cycle_freeze.h"
+#include "psx_cycles.h"
+#include "psx_video_timing.h"
+
+#include <setjmp.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern uint8_t *memory_get_ram_ptr(void);
+extern uint32_t i_stat;
+extern uint8_t *memory_get_scratchpad_ptr(void);
+extern uint32_t dirty_ram_get_bitmap_word(uint32_t word_index);
+extern uint32_t dirty_ram_get_bitmap_word_count(void);
+extern void     dirty_ram_set_bitmap_words(const uint32_t *words, uint32_t count);
+extern void     overlay_watch_invalidate_after_ram_restore(void);
+extern uint32_t pgxp_pass_export(uint32_t *index, void *values, uint32_t cap);
+extern void     pgxp_pass_import(const uint32_t *index, const void *values, uint32_t n);
+extern uint32_t pgxp_value_size(void);
+extern void     gte_precision_checkpoint_begin(void);
+extern void     gte_precision_checkpoint_rollback(void);
+
+#define PW_RAM_BYTES   0x200000u      /* retail main RAM; 8 MiB sessions decline */
+#define PW_SPAD_BYTES  1024u
+#define PW_PAGE        4096u
+#define PW_PAGES       (PW_RAM_BYTES / PW_PAGE)
+#define PW_MAX_PAGES   384u
+#define PW_USER_BYTES  (256u * 1024u)
+#define PW_MAX_PGXP    131072u
+#define PW_PGXP_VALUE  48u            /* >= sizeof(PGXPValue), checked at start */
+#define PW_WATCHDOG    8000000u       /* guest cycles, as a pass's watchdog */
+#define PW_DIRTY_WORDS 64u
+
+typedef struct PwShm {
+    volatile long job_seq, done_seq;
+    int32_t  ok;
+    uint32_t gpr[32], hi, lo, gte_data[32], gte_ctrl[32];
+    uint32_t user_len;
+    uint8_t  user[PW_USER_BYTES];
+    uint8_t  ram[PW_RAM_BYTES];
+    uint8_t  spad[PW_SPAD_BYTES];
+    uint32_t dirty_n, dirty[PW_DIRTY_WORDS];   /* code-tracking bitmap */
+    /* result */
+    uint32_t npages;
+    uint16_t page_idx[PW_MAX_PAGES];
+    uint8_t  pages[PW_MAX_PAGES][PW_PAGE];
+    uint8_t  spad_out[PW_SPAD_BYTES];
+    uint32_t npgxp;
+    uint32_t pgxp_idx[PW_MAX_PGXP];
+    uint8_t  pgxp_val[PW_MAX_PGXP * PW_PGXP_VALUE];
+    double   job_ms;
+} PwShm;
+
+static PSXModPassWorkerJob s_job;
+
+int psx_mod_pass_worker_set_job(PSXModPassWorkerJob job) {
+    s_job = job;
+    return 1;
+}
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+static PwShm  *s_shm;
+static HANDLE  s_map, s_ev_job, s_ev_done, s_child;
+static int     s_helper;            /* this process is the helper */
+static int     s_failed;            /* main: helper unusable for the session */
+static int     s_pending;           /* main: a job is out */
+static int     s_have_result;       /* main: the last job's result is kept */
+static long    s_seq;
+static char    s_launch_game[1024], s_launch_disc[1024];
+static char    s_name[96];
+static PSXModPassWorkerStats s_stats;
+
+/* main.cpp: the resolved game config and disc of this session, for the
+ * helper's command line. */
+void pass_worker_note_launch(const char *game, const char *disc) {
+    snprintf(s_launch_game, sizeof s_launch_game, "%s", game ? game : "");
+    snprintf(s_launch_disc, sizeof s_launch_disc, "%s", disc ? disc : "");
+}
+
+static int open_objects(const char *name, int create) {
+    char n[160];
+    snprintf(n, sizeof n, "Local\\%s_shm", name);
+    s_map = create ? CreateFileMappingA(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0,
+                                        (DWORD)sizeof(PwShm), n)
+                   : OpenFileMappingA(FILE_MAP_ALL_ACCESS, FALSE, n);
+    if (!s_map) return 0;
+    s_shm = (PwShm *)MapViewOfFile(s_map, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(PwShm));
+    if (!s_shm) return 0;
+    snprintf(n, sizeof n, "Local\\%s_job", name);
+    s_ev_job = create ? CreateEventA(NULL, FALSE, FALSE, n) : OpenEventA(EVENT_ALL_ACCESS, FALSE, n);
+    snprintf(n, sizeof n, "Local\\%s_done", name);
+    s_ev_done = create ? CreateEventA(NULL, FALSE, FALSE, n) : OpenEventA(EVENT_ALL_ACCESS, FALSE, n);
+    return s_ev_job && s_ev_done;
+}
+
+int psx_mod_pass_worker_is_helper(void) { return s_helper; }
+
+/* Set (value) or clear (NULL) an environment variable for the child only:
+ * the previous value is kept in old (cap bytes, "" when it was unset). */
+static void env_swap(const char *name, const char *value, char *old, DWORD cap) {
+    DWORD n = GetEnvironmentVariableA(name, old, cap);
+    if (n == 0 || n >= cap) old[0] = '\0';
+    SetEnvironmentVariableA(name, value);
+}
+static void env_restore(const char *name, const char *old) {
+    SetEnvironmentVariableA(name, old[0] ? old : NULL);
+}
+
+int psx_mod_pass_worker_start(void) {
+    if (s_helper || s_failed) return 0;
+    if (s_child) return 1;
+    if (!s_job || psx_ram_live_bytes() != PW_RAM_BYTES || pgxp_value_size() > PW_PGXP_VALUE ||
+        !s_launch_game[0]) {
+        s_failed = 1;
+        return 0;
+    }
+    char exe[MAX_PATH];
+    DWORD el = GetModuleFileNameA(NULL, exe, sizeof exe);
+    if (el == 0 || el >= sizeof exe) { s_failed = 1; return 0; }
+    snprintf(s_name, sizeof s_name, "psxrecomp_pw_%lu", (unsigned long)GetCurrentProcessId());
+    if (!open_objects(s_name, 1)) { s_failed = 1; return 0; }
+    char tmp[MAX_PATH];
+    DWORD tl = GetTempPathA(sizeof tmp, tmp);
+    if (tl == 0 || tl >= sizeof tmp) { s_failed = 1; return 0; }
+    /* One folder for every helper: its memory cards (never written) and its
+     * console output, overwritten per session. */
+    char state_dir[MAX_PATH + 96];
+    snprintf(state_dir, sizeof state_dir, "%spsxrecomp_pass_worker", tmp);
+    CreateDirectoryA(state_dir, NULL);
+    char cmd[4096];
+    snprintf(cmd, sizeof cmd,
+             "\"%s\" --no-launcher --headless --pass-worker %s %lu --memcard-dir \"%s\" "
+             "--game \"%s\"%s%s%s",
+             exe, s_name, (unsigned long)GetCurrentProcessId(), state_dir,
+             s_launch_game, s_launch_disc[0] ? " --disc \"" : "", s_launch_disc,
+             s_launch_disc[0] ? "\"" : "");
+    /* The helper never plays: no audio device, no capture or compile work,
+     * no save-state load, nothing written next to the game. */
+    char captures[MAX_PATH + 160];
+    snprintf(captures, sizeof captures, "%s\\captures.json", state_dir);
+    static char o_audio[256], o_auto[64], o_caps[1024], o_slot[64];
+    env_swap("SDL_AUDIODRIVER", "dummy", o_audio, sizeof o_audio);
+    env_swap("PSX_OVERLAY_AUTOCOMPILE_OFF", "1", o_auto, sizeof o_auto);
+    env_swap("PSX_OVERLAY_CAPTURES", captures, o_caps, sizeof o_caps);
+    env_swap("PSX_LOAD_SLOT", NULL, o_slot, sizeof o_slot);
+    char log_path[MAX_PATH + 160];
+    snprintf(log_path, sizeof log_path, "%s\\helper_log.txt", state_dir);
+    SECURITY_ATTRIBUTES sa = { sizeof sa, NULL, TRUE };
+    HANDLE log = CreateFileA(log_path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                             &sa, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    STARTUPINFOA si; PROCESS_INFORMATION pi;
+    memset(&si, 0, sizeof si); si.cb = sizeof si;
+    if (log != INVALID_HANDLE_VALUE) {
+        si.dwFlags = STARTF_USESTDHANDLES;
+        si.hStdOutput = si.hStdError = log;
+        si.hStdInput = NULL;
+    }
+    memset(&pi, 0, sizeof pi);
+    const BOOL ok = CreateProcessA(NULL, cmd, NULL, NULL, log != INVALID_HANDLE_VALUE,
+                                   CREATE_NO_WINDOW, NULL, NULL, &si, &pi);
+    if (log != INVALID_HANDLE_VALUE) CloseHandle(log);
+    env_restore("SDL_AUDIODRIVER", o_audio);
+    env_restore("PSX_OVERLAY_AUTOCOMPILE_OFF", o_auto);
+    env_restore("PSX_OVERLAY_CAPTURES", o_caps);
+    env_restore("PSX_LOAD_SLOT", o_slot);
+    if (!ok) { s_failed = 1; return 0; }
+    CloseHandle(pi.hThread);
+    s_child = pi.hProcess;
+    s_seq = 0;
+    s_pending = 0;
+    s_have_result = 0;
+    return 1;
+}
+
+static int child_alive(void) {
+    if (!s_child) return 0;
+    if (WaitForSingleObject(s_child, 0) == WAIT_TIMEOUT) return 1;
+    if (!s_failed) {
+        DWORD code = 0;
+        GetExitCodeProcess(s_child, &code);
+        fprintf(stderr, "psxrecomp: render pass worker exited (code 0x%lX); "
+                "passes run in-process\n", (unsigned long)code);
+        s_failed = 1;
+    }
+    return 0;
+}
+
+int psx_mod_pass_worker_submit(const PSXModPassWorkerState *st, const void *user,
+                               uint32_t len) {
+    if (!s_child || s_failed || s_pending || !st || !st->ram || !st->scratchpad ||
+        !st->gpr || !st->gte_data || !st->gte_ctrl || len > PW_USER_BYTES)
+        return 0;
+    if (!child_alive()) { s_failed = 1; return 0; }
+    s_have_result = 0;
+    memcpy(s_shm->ram, st->ram, PW_RAM_BYTES);
+    memcpy(s_shm->spad, st->scratchpad, PW_SPAD_BYTES);
+    s_shm->dirty_n = dirty_ram_get_bitmap_word_count();
+    if (s_shm->dirty_n > PW_DIRTY_WORDS) s_shm->dirty_n = PW_DIRTY_WORDS;
+    for (uint32_t i = 0; i < s_shm->dirty_n; i++) s_shm->dirty[i] = dirty_ram_get_bitmap_word(i);
+    memcpy(s_shm->gpr, st->gpr, sizeof s_shm->gpr);
+    s_shm->hi = st->hi;
+    s_shm->lo = st->lo;
+    memcpy(s_shm->gte_data, st->gte_data, sizeof s_shm->gte_data);
+    memcpy(s_shm->gte_ctrl, st->gte_ctrl, sizeof s_shm->gte_ctrl);
+    s_shm->user_len = len;
+    if (len) memcpy(s_shm->user, user, len);
+    s_shm->ok = 0;
+    MemoryBarrier();
+    s_shm->job_seq = ++s_seq;
+    SetEvent(s_ev_job);
+    s_pending = 1;
+    s_stats.submitted++;
+    return 1;
+}
+
+int psx_mod_pass_worker_pending(void) { return s_pending; }
+
+int psx_mod_pass_worker_result(uint32_t wait_ms) {
+    if (!s_pending) return s_have_result;
+    if (s_shm->done_seq != s_seq) {
+        const DWORD r = WaitForSingleObject(s_ev_done, wait_ms);
+        if (r != WAIT_OBJECT_0 && s_shm->done_seq != s_seq) {
+            if (!child_alive()) { s_failed = 1; s_pending = 0; }
+            s_stats.late++;
+            return 0;
+        }
+    }
+    MemoryBarrier();
+    s_pending = 0;
+    if (!s_shm->ok) { s_stats.failed++; return 0; }
+    s_stats.done++;
+    s_stats.last_job_ms = s_shm->job_ms;
+    s_stats.last_pages = s_shm->npages;
+    s_stats.last_pgxp = s_shm->npgxp;
+    s_have_result = 1;
+    return 1;
+}
+
+int psx_mod_pass_worker_apply(void) {
+    if (!g_psx_render_pass_active || s_helper || !s_shm || !s_have_result) return 0;
+    uint8_t *ram = memory_get_ram_ptr();
+    for (uint32_t i = 0; i < s_shm->npages; i++)
+        memcpy(ram + (size_t)s_shm->page_idx[i] * PW_PAGE, s_shm->pages[i], PW_PAGE);
+    memcpy(memory_get_scratchpad_ptr(), s_shm->spad_out, PW_SPAD_BYTES);
+    pgxp_pass_import(s_shm->pgxp_idx, s_shm->pgxp_val, s_shm->npgxp);
+    return 1;
+}
+
+void psx_mod_pass_worker_get_stats(PSXModPassWorkerStats *out) {
+    if (!out) return;
+    *out = s_stats;
+    out->running = child_alive();
+    out->failed_session = s_failed;
+}
+
+/* ---- helper side ---- */
+static jmp_buf s_jmp;
+static void helper_overrun(void) { longjmp(s_jmp, 1); }
+
+static void helper_job(struct CPUState *cpu) {
+    LARGE_INTEGER t0, t1, f;
+    QueryPerformanceCounter(&t0);
+    uint8_t *ram = memory_get_ram_ptr();
+    /* Load the main process's RAM and its code-tracking bitmap, then
+     * revalidate code as a savestate load does (boot_state.c). */
+    memcpy(ram, s_shm->ram, PW_RAM_BYTES);
+    dirty_ram_set_bitmap_words(s_shm->dirty, s_shm->dirty_n);
+    overlay_watch_invalidate_after_ram_restore();
+    memcpy(memory_get_scratchpad_ptr(), s_shm->spad, PW_SPAD_BYTES);
+    memcpy(cpu->gpr, s_shm->gpr, sizeof s_shm->gpr);
+    cpu->hi = s_shm->hi;
+    cpu->lo = s_shm->lo;
+    memcpy(cpu->gte_data, s_shm->gte_data, sizeof s_shm->gte_data);
+    memcpy(cpu->gte_ctrl, s_shm->gte_ctrl, sizeof s_shm->gte_ctrl);
+    PsxCycleFreeze freeze;
+    int ok = 0;
+    s_shm->npages = 0;
+    s_shm->npgxp = 0;
+    if (psx_cycle_freeze_begin(&freeze, PW_WATCHDOG, helper_overrun)) {
+        gte_precision_checkpoint_begin();
+        if (setjmp(s_jmp) == 0) {
+            ok = s_job ? s_job(cpu, s_shm->user, s_shm->user_len) : 0;
+        } else {
+            /* Runaway job: the host nesting it left is unknown. Report and
+             * exit; the main process falls back to in-process passes. */
+            extern uint32_t g_debug_current_func_addr, g_debug_last_store_pc;
+            fprintf(stderr, "psxrecomp: pass worker job watchdog pc=0x%08X ra=0x%08X "
+                    "function=0x%08X last_store=0x%08X\n", cpu->pc, cpu->gpr[31],
+                    g_debug_current_func_addr, g_debug_last_store_pc);
+            fflush(stderr);
+            s_shm->ok = 0;
+            s_shm->done_seq = s_shm->job_seq;
+            SetEvent(s_ev_done);
+            ExitProcess(3);
+        }
+        uint32_t np = 0;
+        for (uint32_t p = 0; ok && p < PW_PAGES; p++) {
+            if (memcmp(ram + (size_t)p * PW_PAGE, s_shm->ram + (size_t)p * PW_PAGE, PW_PAGE) == 0)
+                continue;
+            if (np == PW_MAX_PAGES) { ok = 0; break; }
+            s_shm->page_idx[np] = (uint16_t)p;
+            memcpy(s_shm->pages[np], ram + (size_t)p * PW_PAGE, PW_PAGE);
+            np++;
+        }
+        s_shm->npages = np;
+        memcpy(s_shm->spad_out, memory_get_scratchpad_ptr(), PW_SPAD_BYTES);
+        if (ok) {
+            const uint32_t n = pgxp_pass_export(s_shm->pgxp_idx, s_shm->pgxp_val, PW_MAX_PGXP);
+            if (n == UINT32_MAX) ok = 0;
+            else s_shm->npgxp = n;
+        }
+        gte_precision_checkpoint_rollback();
+        psx_cycle_freeze_end(&freeze);
+    }
+    QueryPerformanceCounter(&t1);
+    QueryPerformanceFrequency(&f);
+    s_shm->job_ms = (double)(t1.QuadPart - t0.QuadPart) * 1000.0 / (double)f.QuadPart;
+    s_shm->ok = ok;
+}
+
+/* main.cpp --pass-worker: serve jobs until the main process exits. */
+int pass_worker_helper_main(struct CPUState *cpu, const char *name, unsigned long parent_pid) {
+    s_helper = 1;
+    HANDLE parent = OpenProcess(SYNCHRONIZE, FALSE, (DWORD)parent_pid);
+    if (!parent || !open_objects(name, 0) || pgxp_value_size() > PW_PGXP_VALUE) return 2;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+    for (;;) {
+        HANDLE w[2] = { s_ev_job, parent };
+        const DWORD r = WaitForMultipleObjects(2, w, FALSE, INFINITE);
+        if (r != WAIT_OBJECT_0) return 0;            /* the game exited */
+        const long seq = s_shm->job_seq;
+        MemoryBarrier();
+        helper_job(cpu);
+        MemoryBarrier();
+        s_shm->done_seq = seq;
+        SetEvent(s_ev_done);
+        /* A job runs with guest time frozen, and this machine runs nothing
+         * else: a transfer a job started (a GPU or DMA busy window) would
+         * stay busy for every later job. Let one frame of device time pass,
+         * as the game's own frame would, and drop the interrupts it raised
+         * (no guest code here takes them). */
+        psx_advance_cycles(g_psx_vblank_cycles);
+        i_stat = 0;
+    }
+}
+
+#else  /* !_WIN32 */
+
+void pass_worker_note_launch(const char *game, const char *disc) {
+    (void)game; (void)disc;
+}
+int psx_mod_pass_worker_is_helper(void) { return 0; }
+int psx_mod_pass_worker_start(void) { return 0; }
+int psx_mod_pass_worker_submit(const PSXModPassWorkerState *st, const void *user,
+                               uint32_t len) {
+    (void)st; (void)user; (void)len; return 0;
+}
+int psx_mod_pass_worker_pending(void) { return 0; }
+int psx_mod_pass_worker_result(uint32_t wait_ms) { (void)wait_ms; return 0; }
+int psx_mod_pass_worker_apply(void) { return 0; }
+void psx_mod_pass_worker_get_stats(PSXModPassWorkerStats *out) {
+    if (out) memset(out, 0, sizeof *out);
+}
+int pass_worker_helper_main(struct CPUState *cpu, const char *name, unsigned long parent_pid) {
+    (void)cpu; (void)name; (void)parent_pid; return 2;
+}
+#endif
