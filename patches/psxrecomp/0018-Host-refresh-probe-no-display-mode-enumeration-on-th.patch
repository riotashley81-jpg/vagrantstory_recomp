From: riotashley81-jpg <riotashley81@gmail.com>
Date: Wed, 14 Oct 2026 23:40:47 +0200
Subject: [PATCH 18/19] Host refresh probe: no display-mode enumeration on the
 emulation thread

SDL3's SDL_GetCurrentDisplayMode re-enumerates every fullscreen mode
after any WM_DISPLAYCHANGE (0.3-2 s on multi-monitor PCs), and the
once-a-second refresh probe ran it on the emulation thread, freezing
the game and starving audio. Read the cached desktop/fullscreen mode
instead, and enumerate for the VRR maximum only when VSync adaptive is
on and the display or its refresh changes.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 runtime/include/psx_sdl.h | 30 +++++++++++++++++++++++++++++-
 runtime/src/main.cpp      | 24 ++++++++++++++++++------
 2 files changed, 47 insertions(+), 7 deletions(-)

diff --git a/runtime/include/psx_sdl.h b/runtime/include/psx_sdl.h
index 74a7cb6d..6ca26da4 100644
--- a/runtime/include/psx_sdl.h
+++ b/runtime/include/psx_sdl.h
@@ -137,8 +137,27 @@ static inline int psx_sdl_get_current_display_mode(
     return 0;
 }
 
+/* The refresh rate a window is presented at: its exclusive fullscreen mode
+ * when it has one, else the desktop mode of its display; 0 when unknown.
+ * Cheap enough to poll: SDL3's SDL_GetCurrentDisplayMode re-enumerates every
+ * fullscreen mode of the display (EnumDisplaySettings plus a DXGI factory per
+ * mode on Windows, 0.3-2 s on some multi-monitor PCs) whenever its mode list
+ * was reset, which every WM_DISPLAYCHANGE does. */
+static inline double psx_sdl_window_refresh_hz(SDL_Window *window,
+                                               SDL_DisplayID display)
+{
+    if (window && (SDL_GetWindowFlags(window) & SDL_WINDOW_FULLSCREEN)) {
+        const SDL_DisplayMode *fs = SDL_GetWindowFullscreenMode(window);
+        if (fs && fs->refresh_rate > 0.0f) return (double)fs->refresh_rate;
+    }
+    if (!display) display = SDL_GetPrimaryDisplay();
+    const SDL_DisplayMode *desktop = SDL_GetDesktopDisplayMode(display);
+    return desktop ? (double)desktop->refresh_rate : 0.0;
+}
+
 /* The highest refresh the display offers at the current mode's size (a VRR
- * or ProMotion panel's maximum); 0 when unknown. */
+ * or ProMotion panel's maximum); 0 when unknown. Enumerates every display
+ * mode: call it when the display or its refresh changes, not per frame. */
 static inline double psx_sdl_display_max_refresh(SDL_DisplayID display)
 {
     if (!display) display = SDL_GetPrimaryDisplay();
@@ -288,6 +307,15 @@ static inline int psx_sdl_display_pixel_height(SDL_Window *window)
     return mode.h;
 }
 
+static inline double psx_sdl_window_refresh_hz(SDL_Window *window, int display)
+{
+    SDL_DisplayMode cur;
+    (void)window;
+    if (display < 0) display = 0;
+    if (SDL_GetCurrentDisplayMode(display, &cur) != 0) return 0.0;
+    return (double)cur.refresh_rate;
+}
+
 static inline double psx_sdl_display_max_refresh(int display)
 {
