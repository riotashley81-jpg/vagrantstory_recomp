diff --git a/runtime/src/main.cpp b/runtime/src/main.cpp
index 278ea86a..c4a10836 100644
--- a/runtime/src/main.cpp
+++ b/runtime/src/main.cpp
@@ -3471,14 +3471,26 @@ static void refresh_host_display_cadence(int force_log, int force_probe) {
     }
     g_host_refresh_last_probe_ms = now_ms ? now_ms : 1ull;
 
+    /* This runs on the emulation thread once a second, so it reads only the
+     * cached desktop/fullscreen mode. The panel maximum needs every display
+     * mode enumerated (up to seconds on some PCs), is only used by VSync
+     * "adaptive" (2), and is only re-read when that mode is on and the
+     * display, its refresh or a forced probe asks for it. */
+    static double s_max_hz_cache = 0.0;
+    static int s_max_hz_display = -1;
+    static double s_max_hz_for_hz = 0.0;
     double host_hz = 0.0, max_hz = 0.0;
     if (disp_idx >= 0) {
-        SDL_DisplayMode dm;
-        if (SDL_GetCurrentDisplayMode(disp_idx, &dm) == 0 &&
-            dm.refresh_rate > 0) {
-            host_hz = (double)dm.refresh_rate;
-            /* The panel's maximum refresh at this size (VRR targets it). */
-            max_hz = psx_sdl_display_max_refresh(disp_idx);
+        host_hz = psx_sdl_window_refresh_hz(sdl_window, disp_idx);
+        if (host_hz > 0.0 && g_video_vsync == 2) {
+            if (force_probe || disp_idx != s_max_hz_display ||
+                std::fabs(host_hz - s_max_hz_for_hz) > 0.05) {
+                /* The panel's maximum refresh at this size (VRR targets it). */
+                s_max_hz_cache = psx_sdl_display_max_refresh(disp_idx);
+                s_max_hz_display = disp_idx;
+                s_max_hz_for_hz = host_hz;
+            }
+            max_hz = s_max_hz_cache;
         }
     }
