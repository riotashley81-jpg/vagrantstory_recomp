+/* A GPR operand that can contribute nothing to either tier: no flag on its
+ * half shadow (comp_tracked, half_exact, has_depth and half_scalar all need
+ * one) and no scalar of this generation. A live shadow with no flags and a
+ * dead one differ only in fields every reader guards with a flag. */
+PGXP_HOT int gpr_inert(uint32_t r) {
+    return r == 0 ||
+           ((s_gpr[r].gen != s_gen || s_gpr[r].flags == 0) &&
+            s_gpr_s[r].gen != s_gen);
+}
+
+/* Could alu_scalar find a precise operand? It needs a live scalar or a half
+ * shadow tracking both halves (half_scalar); without one it only names the
+ * destination and returns 0. */
+PGXP_HOT int gpr_may_be_precise(uint32_t r) {
+    return r != 0 && (s_gpr_s[r].gen == s_gen ||
+                      (s_gpr[r].gen == s_gen &&
+                       (s_gpr[r].flags & PGXP_F_VXY) == PGXP_F_VXY));
+}
+
+/* The ALU ops whose result, from inert operands (or from any operands, for
+ * the ops neither tier tracks), is just "known word, no precision": the
+ * destination shadow resets and its scalar dies. This is what alu_scalar +
+ * alu_halves produce for them, without the calls; it runs for every guest
+ * ALU instruction, so the common untracked case must stay cheap. Ops that
+ * can create exact halves from nothing (LUI, ANDI/ORI/XORI, the bitwise
+ * group, shifts by 16 in cpu-mode) and the HI/LO moves take the full path.
+ * Returns the destination register, or -1 for the full path. */
+PGXP_HOT int alu_untracked_dst(uint32_t op, uint32_t funct, uint32_t instr,
+                               uint32_t s2) {
+    if (op == 0) {
+        switch (funct) {
+        case 0x00: case 0x02: case 0x03:       /* SLL / SRL / SRA             */
+        case 0x04: case 0x06: case 0x07: {     /* SLLV / SRLV / SRAV          */
+            /* The half tier follows only a shift by 16, and only in cpu-mode;
+             * the scalar tier follows any shift of a precise value. */
+            const uint32_t sh = funct < 4 ? f_shamt(instr) : (s2 & 31u);
+            if (!s_cpu_mode) return (int)f_rd(instr);
+            if (sh == 16) return -1;
+            return gpr_may_be_precise(f_rt(instr)) ? -1 : (int)f_rd(instr);
+        }
+        case 0x20: case 0x21: case 0x22: case 0x23: {  /* ADD(U) / SUB(U)     */
+            /* Outside cpu-mode only the MOVE idioms carry a shadow. */
+            const uint32_t rs = f_rs(instr), rt = f_rt(instr);
+            const int move = rt == 0 || (funct < 0x22 && rs == 0);
+            if (!s_cpu_mode && !move) return (int)f_rd(instr);
+            return gpr_inert(rs) && gpr_inert(rt) ? (int)f_rd(instr) : -1;
+        }
+        case 0x10: case 0x11: case 0x12: case 0x13:    /* HI / LO moves       */
+        case 0x24: case 0x25: case 0x26: case 0x27:    /* AND/OR/XOR/NOR      */
+            return -1;
+        default:                               /* SLT/SLTU/...: never a vertex */
+            return (int)f_rd(instr);
+        }
+    }
+    if (op == 0x08 || op == 0x09) {            /* ADDI / ADDIU                */
+        if (!s_cpu_mode && (instr & 0xFFFFu) != 0) return (int)f_rt(instr);
+        return gpr_inert(f_rs(instr)) ? (int)f_rt(instr) : -1;
+    }
+    if (op >= 0x0C && op <= 0x0F)              /* ANDI/ORI/XORI/LUI           */
+        return -1;
+    return (int)f_rt(instr);                   /* SLTI/SLTIU, MFC0/CFC0       */
+}
 
