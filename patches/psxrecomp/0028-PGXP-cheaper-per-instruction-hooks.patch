+/* One ALU hook, its opcode (and SPECIAL function) decoded once. */
+PGXP_HOT void alu_body(uint32_t op, uint32_t funct, uint32_t instr,
+                       uint32_t result, uint32_t s1, uint32_t s2) {
+    const int quick = alu_untracked_dst(op, funct, instr, s2);
+    if (quick >= 0) {
+        if (quick != 0) {
+            pv_reset(&s_gpr[quick], result);
+            if (s_cpu_mode) sc_kill(&s_gpr_s[quick]);
+        }
+        return;
+    }
+    int dst = -1;
+    double v = 0.0;
+    int has = 0;
+    if (s_cpu_mode) {
+        if (alu_scalar_possible(op, funct, instr))
+            has = alu_scalar(op, funct, instr, result, s1, s2, &dst, &v);
+        else
+            dst = alu_scalar_dst(op, funct, instr);
+    }
+    alu_halves(op, funct, instr, result, s1, s2);
+    if (dst > 0 && dst < 34) {
+        if (has) sc_set(&s_gpr_s[dst], v, result);
+        else     sc_kill(&s_gpr_s[dst]);
+    }
+}
+
+extern "C" void psx_pgxp_alu(struct CPUState *cpu, uint32_t instr,
+                             uint32_t result, uint32_t s1, uint32_t s2) {
+    (void)cpu;
+    if (!g_pgxp_active) return;
+    alu_body(f_op(instr), f_funct(instr), instr, result, s1, s2);
+}
