From c847d8eebbf1dbf93b30cb98c537abe9aa5ad308 Mon Sep 17 00:00:00 2001
From: riotashley81-jpg <riotashley81@gmail.com>
Date: Sun, 18 Oct 2026 15:51:37 +0200
Subject: [PATCH 33/33] Cycles: inline fast path for psx_cyc_charge

MSVC never inlines psx_cyc_charge into the out-of-line psx_cyc_step and load
helpers, so every guest instruction paid a call into the full charge path.
psx_cyc_charge is now a forced-inline front for the one case the full path
settles with an add: a batch is already open and the charge keeps it under
the limit recorded when it opened (g_psx_cyc_fast_limit). Everything else -
opening a batch, guest_cycle_scale, lockstep replay, conservative stepping,
device service, local accumulators, publishing - goes through the unchanged
full path (psx_cyc_charge_full). The fast limit is 0 or a copy of the open
batch's limit; every writer of the batch, its limit or a special mode clears
it, and 0 only routes charges to the full path.

Only the front is forced. Forcing psx_cyc_step / load helpers into every
instruction too quadrupled the executable and gained ~1%.

Changes the codegen hash (psx_cyc.h / psx_cycles.h): existing savestates and
overlay-DLL caches are keyed on it. The emitted C and the DLL path are
unchanged, so states and caches re-tagged to the new hash are valid.

Behaviour-identical: [BENCH_STATE] guest cycles, RAM and GP0/GP1 hashes match
the previous build over 1200 frames from savestates 9 and 1 (3 runs each).
Opening cutscene (MSVC Release): host cycles -4.5%, busy 60.8% -> 58.2%;
slot 1 cutscene -4.7%, 59.3% -> 56.5%.

Also: [BENCH_STATE_CHUNKS] per-64 KiB RAM hashes (PSX_BENCH_STATE_CHUNKS=1).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 runtime/include/psx_cyc.h      | 23 ++++++++++++++++++++++-
 runtime/include/psx_cycles.h   | 22 ++++++++++++++++++++++
 runtime/src/debug_server.c     |  1 +
 runtime/src/dirty_ram_interp.c |  3 +++
 runtime/src/main.cpp           | 10 ++++++++++
 runtime/src/psx_cycles.c       | 10 +++++++++-
 6 files changed, 67 insertions(+), 2 deletions(-)

diff --git a/runtime/include/psx_cyc.h b/runtime/include/psx_cyc.h
index 0a95f0ff..6022535d 100644
--- a/runtime/include/psx_cyc.h
+++ b/runtime/include/psx_cyc.h
@@ -67,6 +67,7 @@ static inline void psx_cyc_local_begin(uint32_t *acc) {
 #if !defined(PSX_COSIM)
     if (acc) *acc = 0;
     g_psx_cyc_local_acc = acc;
+    g_psx_cyc_fast_limit = 0;
 #else
     (void)acc;
 #endif
@@ -90,7 +91,9 @@ static inline void psx_cyc_local_cleanup(uint32_t **guard) {
 }
 #endif
 
-static inline void psx_cyc_charge(uint32_t cycles) {
+/* The full charge path. psx_cyc_charge below is its inline front: it takes
+ * only the case this function would settle by adding to an open batch. */
+static inline void psx_cyc_charge_full(uint32_t cycles) {
     if (cycles == 0u) return;
 #if defined(PSX_OVERLAY_DLL_BUILD)
     psx_cpu_charge(cycles);
@@ -147,6 +150,8 @@ static inline void psx_cyc_charge(uint32_t cycles) {
                 g_psx_cyc_batch_limit = room == 0u ? 1u :
                     (room < (uint64_t)PSX_CYC_BATCH_SOFT
                         ? (uint32_t)room : (uint32_t)PSX_CYC_BATCH_SOFT);
+                /* Every special mode was ruled out above. */
+                g_psx_cyc_fast_limit = g_psx_cyc_batch_limit;
             }
             if (sum < g_psx_cyc_batch_limit) {
                 g_psx_cyc_batch = sum;
@@ -159,6 +164,22 @@ static inline void psx_cyc_charge(uint32_t cycles) {
 #endif
 }
 
+/* One guest charge. Fast path: a batch is already open and the charge keeps
+ * it under the limit recorded when it opened (g_psx_cyc_fast_limit, psx_
+ * cycles.h) -- exactly the case the full path settles with the same add.
+ * cycles == 0 leaves the batch unchanged, as the full path's early return. */
+PSX_CYC_FORCEINLINE void psx_cyc_charge(uint32_t cycles) {
+#if !defined(PSX_OVERLAY_DLL_BUILD) && !defined(PSX_COSIM)
+    const uint32_t prior = g_psx_cyc_batch;
+    const uint32_t sum = prior + cycles;
+    if (prior != 0u && sum < g_psx_cyc_fast_limit) {
+        g_psx_cyc_batch = sum;
+        return;
+    }
+#endif
+    psx_cyc_charge_full(cycles);
+}
+
 /* §1 base (Beetle cpu.cpp:795-798). */
 static inline void psx_cyc_base(CPUState* cpu) {
     uint8_t w = cpu->read_absorb_which;
diff --git a/runtime/include/psx_cycles.h b/runtime/include/psx_cycles.h
index dd72f819..6981984a 100644
--- a/runtime/include/psx_cycles.h
+++ b/runtime/include/psx_cycles.h
@@ -57,6 +57,25 @@ extern int g_ls_replay_active;
 extern uint32_t g_psx_cyc_batch;
 extern uint32_t g_psx_cyc_batch_limit;
 
+/* Inline charge fast path (psx_cyc.h psx_cyc_charge): 0, or a copy of
+ * g_psx_cyc_batch_limit taken when the full path opened the current batch
+ * with every special mode off (no guest_cycle_scale, lockstep replay,
+ * conservative stepping, device service or local accumulator). While a batch
+ * is open and a charge stays under it, the fast path adds exactly as the full
+ * path would. Zero is always safe -- it only sends charges down the full path
+ * -- so every writer of the batch, its limit or a special mode clears it. */
+extern uint32_t g_psx_cyc_fast_limit;
+
+/* MSVC stops inlining inside the huge recompiled functions. Only the tiny
+ * charge front (psx_cyc.h) is forced: it lands in the out-of-line
+ * psx_cyc_step / load helper bodies, not at every instruction. Forcing those
+ * helpers into every site too quadrupled the executable and ran ~15% slower. */
+#if defined(_MSC_VER) && !defined(__clang__)
+#define PSX_CYC_FORCEINLINE static __forceinline
+#else
+#define PSX_CYC_FORCEINLINE static inline
+#endif
+
 /* GCC/Clang-generated functions can defer deadline probes within a basic
  * block. Interrupt/MMIO edges still publish the accumulated guest cycles. */
 extern int g_psx_cyc_bb_defer;
@@ -158,6 +177,7 @@ static inline void psx_advance_cycles(uint32_t cycles) {
         uint32_t b = g_psx_cyc_batch;
         g_psx_cyc_batch = 0;
         g_psx_cyc_batch_limit = 0;
+        g_psx_cyc_fast_limit = 0;
         if (cycles <= UINT32_MAX - b) cycles += b;
         else {
             /* Extreme: publish b first, then continue with cycles. */
@@ -232,6 +252,7 @@ static inline void psx_cyc_local_publish(void) {
     g_psx_cyc_local_acc = NULL;
     psx_advance_cycles(v);
     g_psx_cyc_local_acc = acc;
+    g_psx_cyc_fast_limit = 0;
 #endif
 }
 
@@ -242,6 +263,7 @@ static inline void psx_cyc_batch_flush(void) {
     if (!b) return;
     g_psx_cyc_batch = 0;
     g_psx_cyc_batch_limit = 0;
+    g_psx_cyc_fast_limit = 0;
     psx_advance_cycles(b);
 #endif
 }
diff --git a/runtime/src/debug_server.c b/runtime/src/debug_server.c
index 7d6d6b16..2bd63b05 100644
--- a/runtime/src/debug_server.c
+++ b/runtime/src/debug_server.c
@@ -14399,6 +14399,7 @@ static void handle_overlay_native_event_granularity(int id, const char *json)
     }
     int conservative = (strcmp(mode, "conservative") == 0);
     g_event_step_conservative = conservative;
+    { extern uint32_t g_psx_cyc_fast_limit; g_psx_cyc_fast_limit = 0; }  /* psx_cycles.h */
     send_fmt("{\"id\":%d,\"ok\":true,\"event_granularity\":\"%s\"}\n",
              id, conservative ? "conservative" : "normal");
 }
diff --git a/runtime/src/dirty_ram_interp.c b/runtime/src/dirty_ram_interp.c
index 434f22a5..16ef2ae1 100644
--- a/runtime/src/dirty_ram_interp.c
+++ b/runtime/src/dirty_ram_interp.c
@@ -3802,6 +3802,7 @@ int ls_shadow_replay_begin(void) {
     s_ls_replay_done = 0;
