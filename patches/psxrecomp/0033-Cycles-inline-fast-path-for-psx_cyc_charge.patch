     g_ls_replay_active = 1;
+    { extern uint32_t g_psx_cyc_fast_limit; g_psx_cyc_fast_limit = 0; }  /* replay charges: full path */
     g_ls_mode = 2;
     return 1;
 }
@@ -3906,6 +3907,7 @@ static void ls_replay_and_compare(CPUState *cpu, uint32_t frame, uint32_t target
     uint32_t    sav_unsup_insn   = g_unsupported_insn;
     const char *sav_unsup_reason = g_unsupported_reason;
     g_ls_replay_active = 1;
+    { extern uint32_t g_psx_cyc_fast_limit; g_psx_cyc_fast_limit = 0; }  /* replay charges: full path */
     g_ls_mode = 2;
     uint32_t pc = rep.pc;
     int cap = 512, steps = 0;
@@ -4024,6 +4026,7 @@ static void lsf_replay_and_compare(CPUState *native_post, uint32_t frame,
     uint32_t    sav_func_addr    = g_debug_current_func_addr;
 
     g_ls_replay_active = 1;
+    { extern uint32_t g_psx_cyc_fast_limit; g_psx_cyc_fast_limit = 0; }  /* replay charges: full path */
     g_ls_mode = 2;
 
     uint32_t pc = entry_pc;
diff --git a/runtime/src/main.cpp b/runtime/src/main.cpp
index 6e04c295..09669bbc 100644
--- a/runtime/src/main.cpp
+++ b/runtime/src/main.cpp
@@ -4354,6 +4354,16 @@ static void runtime_perf_bench_state(const char *edge) {
                  (unsigned long long)bench_fnv1a(g_psx_ram, g_psx_ram_size),
                  (unsigned long long)bench_fnv1a(gpu_get_vram_ptr(), gpu_get_vram_bytes()),
                  (unsigned long long)g_gpu_cmd_hash);
+    /* PSX_BENCH_STATE_CHUNKS=1: one hash per 64 KiB of RAM, to locate which
+     * region two runs disagree on. */
+    static int chunks = -1;
+    if (chunks < 0) { const char *e = std::getenv("PSX_BENCH_STATE_CHUNKS"); chunks = e && e[0] == '1'; }
+    if (chunks) {
+        std::fprintf(stdout, "[BENCH_STATE_CHUNKS] %s", edge);
+        for (uint32_t off = 0; off < g_psx_ram_size; off += 0x10000u)
+            std::fprintf(stdout, " %08x", (unsigned)bench_fnv1a(g_psx_ram + off, 0x10000u));
+        std::fprintf(stdout, "\n");
+    }
 }
 
