diff --git a/runtime/src/psx_cycles.c b/runtime/src/psx_cycles.c
index 0e5e91a2..789e3516 100644
--- a/runtime/src/psx_cycles.c
+++ b/runtime/src/psx_cycles.c
@@ -22,6 +22,7 @@
 #endif
 
 uint64_t psx_cycle_count = 0;
+extern uint32_t g_psx_cyc_fast_limit;   /* defined with the batch below */
 uint32_t g_psx_gcs_recip_q16 = 65536u;
 uint32_t g_psx_gcs_frac = 0u;
 static uint32_t s_psx_gcs_cfg = 1u;     /* [timing] guest_cycle_scale */
@@ -41,6 +42,7 @@ static void psx_guest_cycle_scale_apply(void) {
     uint32_t n = open ? s_psx_gcs_cfg : 1u;
     if (n == s_psx_gcs_live) return;
     s_psx_gcs_live = n;
