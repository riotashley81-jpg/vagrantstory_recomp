+/* ---- native-wide auxiliary layer (local patch) ----------------------------
+ * Some games draw part of the scene into a display-sized offscreen layer and
+ * paste it back over the display buffer with textured sprites (Vagrant
+ * Story's depth-of-field: the foreground characters go to 704,256 and come
+ * back as blurred 32x32 tiles). The layer has a wide surface of its own
+ * (gpu_ws_set_aux_target), but the tiles only cover the 4:3 frame. A batch
+ * that samples the layer is therefore drawn again into the display's reveal
+ * margins, shifted by whole display widths in both position and texel x, so
+ * the tile pattern continues; texels left or right of the layer's canonical
+ * columns come from its wide surface. */
+static int aux_batch_live(int nverts) {
+    if (s_aux_x < 0 || s_aux_age > 4 || !g_wide_cur || g_wide_cur_base == s_aux_x ||
+        g_wide_off <= 0 || s_tb_bank_tex || s_ws_ablate != 0) return 0;
+    int native_w = g_wide_w - 2 * g_wide_off;
+    if (native_w <= 0) return 0;
+    for (int i = 0; i < nverts; i++) {
+        const float *v = &s_tb[i * TEXV];
+        if (v[12] == 2.0f && v[25] == 0.0f &&
+            v[8] >= (float)s_aux_x && v[8] < (float)(s_aux_x + native_w) &&
+            v[9] + 255.0f >= (float)s_aux_y0 && v[9] < (float)s_aux_y1) return 1;
+    }
+    return 0;
+}
+/* The margin copies of a textured batch already bound for drawing into the
+ * current wide surface (vertex data uploaded, tex program in use); wdx is its
+ * plain mirror shift, [sy, sy+sh) its rows. Leaves u_xoff at wdx. */
+static void aux_copy_passes(int nverts, int semi, int mask, int check,
+                            int wdx, int sy, int sh) {
+    GLuint tex = 0;
+    for (int i = 0; i < WIDE_MAX_SURF; i++)
+        if (s_wide_fbo[i] && s_wide_base[i] == s_aux_x) tex = s_wide_tex[i];
+    int native_w = g_wide_w - 2 * g_wide_off, S = s_out_scale;
+    if (!tex || native_w <= 0 || sh <= 0) return;
+    p_glActiveTexture(PSXGL_TEXTURE0 + 3);
+    glBindTexture(GL_TEXTURE_2D, tex);
+    p_glActiveTexture(PSXGL_TEXTURE0);
+    p_glUniform1i(s_uAuxTex, 3);
+    p_glUniform4i(s_uAuxRect, s_aux_x, s_aux_y0, s_aux_x + native_w, s_aux_y1);
+    p_glUniform4i(s_uAuxGeom, g_wide_off, g_wide_w, S, 0);
+    p_glUniform1i(s_uAux, 1);
+    glEnable(GL_SCISSOR_TEST);
+    for (int k = 1; (k - 1) * native_w < g_wide_off; k++) {
+        for (int side = -1; side <= 1; side += 2) {
+            int shift = side * k * native_w;
+            int x0 = side < 0 ? 0 : g_wide_off + native_w;
+            int x1 = side < 0 ? g_wide_off : g_wide_w;
+            glScissor(x0 * S, sy * S, (x1 - x0) * S, sh * S);
+            p_glUniform1f(s_tex_uXoff, (float)(wdx + shift));
+            p_glUniform1i(s_uAuxShift, shift);
+            tex_draw_passes_ex(nverts, semi, mask, check, 0);
+        }
+    }
+    p_glUniform1i(s_uAux, 0);
+    p_glUniform1i(s_uAuxShift, 0);
+    p_glUniform1f(s_tex_uXoff, (float)wdx);
+}
