+/* Refresh grid: a 59.94 Hz guest at 60 presents/s on a 120 Hz display, the
+ * host clock 0.1% off the display's. Every present sits on the grid, exactly
+ * two refreshes apart, however the two clocks drift. A rate off whole
+ * refreshes (60 on 144 Hz) leaves the grid off and the old cadence. */
+static void test_refresh_grid(void) {
+    FrameInterpolationSchedule s;
+    const double f = 10000000.0, per = f / 120.0 * 1.001, lead = per * 0.5;
+    double vb = 12345.0, prev = 0.0, now = 1000000.0;
+    int presents = 0, spaced = 1, on_grid = 1;
+    frame_interpolation_schedule_reset(&s);
+    for (int i = 0; i < 2000; i++) {
+        uint64_t d;
+        float a;
+        while (vb + per <= now) vb += per;   /* the display's last vblank */
+        frame_interpolation_schedule_set_grid(&s, vb - lead, per);
+        CHECK(frame_interpolation_schedule_begin(&s, (uint64_t)now, (uint64_t)f,
+                                                 59.94, 60.0),
+              "grid begin");
+        CHECK(s.grid_period > 0.0, "59.94/60 on 120 Hz should lock");
+        while (frame_interpolation_schedule_next(&s, (uint64_t)now, &d, &a)) {
+            const double k = ((double)d - (vb - lead)) / per;
+            if (fabs(k - floor(k + 0.5)) > 1e-3) on_grid = 0;
+            if (prev > 0.0 && fabs(((double)d - prev) / per - 2.0) > 1e-3) spaced = 0;
+            prev = (double)d;
+            presents++;
+            now = (double)d + 2000.0;
+        }
+        now = (double)frame_interpolation_schedule_end(&s) + 3000.0;
+    }
+    CHECK(presents == 2000, "one present per guest frame at 60 on 120 Hz");
+    CHECK(on_grid, "presents sit on the refresh grid");
+    CHECK(spaced, "presents are exactly two refreshes apart");
+
+    frame_interpolation_schedule_reset(&s);
+    frame_interpolation_schedule_set_grid(&s, 0.0, f / 144.0);
+    CHECK(frame_interpolation_schedule_begin(&s, 1000000u, (uint64_t)f, 59.94, 60.0),
+          "off-grid begin");
+    CHECK(s.grid_period == 0.0, "60 presents/s on 144 Hz must not lock");
+}
+
 int main(void) {
