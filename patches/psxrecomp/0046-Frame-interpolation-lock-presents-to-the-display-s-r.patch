 runtime/include/frame_interpolation.h         |  13 ++
 runtime/include/frame_pacing.h                |  15 ++
 runtime/src/debug_server.c                    |  11 +
 runtime/src/frame_interpolation.c             |  56 +++++-
 runtime/src/frame_pacing.c                    | 188 ++++++++++++++++++
 runtime/src/gpu_gl_renderer.c                 |  50 ++++-
 .../tests/test_frame_interpolation_schedule.c |  41 ++++
 8 files changed, 381 insertions(+), 5 deletions(-)

diff --git a/docs/FRAME_RATE.md b/docs/FRAME_RATE.md
index cc9d9482..def7348d 100644
--- a/docs/FRAME_RATE.md
+++ b/docs/FRAME_RATE.md
@@ -60,7 +60,17 @@ FLIP mode shows about 30 captures and 30 duplicates per second.
 - OpenGL only; a command-line `--renderer` override after activation drops
   it. Netplay sessions run without mods, so without interpolation.
 - FMV (MDEC / 24-bit) frames suspend it, as does rewind.
-- Vsync is off: on a fixed-refresh panel pick the display refresh rate.
+- Vsync is off, except where the presenter can lock to the display's
+  refresh: when the compositor reports its vblank grid (Windows DWM) and the
+  guest and output rates are within 2% of whole refreshes (60 presents/s on
+  60/120/240 Hz), every present sits half a refresh before a vblank and the
+  swap waits for vblank. Measured on a 120 Hz panel (Vagrant Story, render
+  passes at 60): images held the intended two refreshes 39% -> 86% of the
+  time. `PSX_INTERP_REFRESH_LOCK=0` turns the lock off, `2` keeps vsync off.
+  Off whole refreshes (60 on 144 Hz) the host timer cadence is unchanged.
+- `PSX_PRESENT_PACING=1` records every swap and logs, every 5 s, refreshes
+  per presented image and how late scheduled presents start (TCP
+  `present_pacing` in debug builds).
 
 Tests: `frame_interpolation_schedule_test` (runtime ctest) covers the phase
 windows, the flip tracker, the new-frame decision and output counts per rate
diff --git a/runtime/include/frame_interpolation.h b/runtime/include/frame_interpolation.h
index 4e80efc5..383e1bda 100644
--- a/runtime/include/frame_interpolation.h
+++ b/runtime/include/frame_interpolation.h
@@ -17,8 +17,21 @@ typedef struct FrameInterpolationSchedule {
      * plans the whole 0..1 window, which is the historical behaviour. */
     double phase_lo;
     double phase_hi;
+    /* Display refresh grid (set_grid): host ticks of a point a fixed lead
+     * before a display vblank, and the refresh period. 0 = no grid. */
+    double grid_origin;
+    double grid_period;
 } FrameInterpolationSchedule;
 
+/* Lock the schedule to the display's refresh grid. With a grid, a source or
+ * output period within 2% of a whole number of refreshes becomes exactly that
+ * many refreshes, and every deadline sits on the grid, so each image stays on
+ * screen for the same number of refreshes instead of 1-or-3 as the host timer
+ * and the display drift past each other. Call before each begin(); the origin
+ * follows the display's own clock. period <= 0 turns the grid off. */
+void frame_interpolation_schedule_set_grid(FrameInterpolationSchedule *schedule,
+                                           double origin, double period);
+
 /* Plan one stock guest-frame interval. Presentation deadlines remain anchored
  * across calls so guest work consumes part of the interval instead of slowing
  * the simulation. Returns zero when the rates or host clock are invalid. */
diff --git a/runtime/include/frame_pacing.h b/runtime/include/frame_pacing.h
index 44eb4313..475a2aab 100644
--- a/runtime/include/frame_pacing.h
+++ b/runtime/include/frame_pacing.h
@@ -55,6 +55,21 @@ void frame_pacer_wait(FramePacer *p, double period_ms);
  * a game that presents every other vblank runs at 2x. */
 int psx_present_vsync_owns_cadence(void);
 
+/* Present pacing diagnostic (PSX_PRESENT_PACING=1, TCP "present_pacing").
+ * Records the host time after every window swap and, on Windows, the
+ * compositor's vblank grid (DwmGetCompositionTimingInfo), so a session can
+ * see how many display refreshes each presented image stayed on screen.
+ * Off by default: present_pacing_note_swap() is one branch then. */
+void present_pacing_note_swap(void);
+
+/* The display's refresh grid: the host perf-counter time of its last vblank
+ * and the refresh period in perf-counter ticks (Windows: the compositor's
+ * DwmGetCompositionTimingInfo). 0 where the platform does not report it. */
+int psx_host_vblank_grid(uint64_t *last_vblank, uint64_t *period);
+int present_pacing_json(char *out, int cap, int reset);
+/* A scheduled present is about to be drawn: how late it starts. */
+void present_pacing_note_deadline(uint64_t deadline);
+
 #ifdef __cplusplus
 }
 #endif
