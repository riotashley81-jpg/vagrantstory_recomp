+    p_glUniform1i(s_uFbTex, 4);
 }
 static int   s_tb_twin[4] = {0, 0, 0, 0};
 static uint64_t s_batch_total = 0, s_batch_reason[8];
@@ -4087,6 +4106,7 @@ static void flush_tex_batch_impl(void) {
 
     depth_apply_ex(dmode, 1);
     tex_batch_draw_passes(nverts, semi);
+    if (s_fbfb_live) p_glUniform1i(s_uFb, 0);   /* hr only; mirrors read the pack */
     if (aux && !s_hiw) aux_edge_canonical(nverts, semi);
     depth_restore_ex(dmode, 1, nverts);
 
@@ -4959,6 +4979,58 @@ static void gpu_flat_rect(int x,int y,int w,int h,uint16_t c,int semi) {
     }
 }
 
+/* Hi-res framebuffer feedback (local patch). A sprite that copies rendered
+ * pixels 1:1 out of a 15-bit page (Vagrant Story's menu crossfade redraws the
+ * frame it just rendered, darkened, every frame) would read the packed 1x
+ * VRAM: one point sample per PS1 pixel at 5 bits per channel. Undithered
+ * hi-res shading then snaps whole flat areas to one 5-bit step and the fade
+ * breaks into black blotches. Such a sprite samples a copy of the hr surface
+ * instead (canonical pass only; native-wide mirrors and the windowed surface
+ * keep the packed source). It applies only when the source overlaps the
+ * draw area, i.e. the frame being drawn reads itself back; offscreen layers
+ * (Vagrant Story's depth-of-field tiles) keep the packed source, which their
+ * native-wide margins match. */
+static int fbfb_begin(int w, int h, int u0, int v0, int u1, int v1, uint16_t tp) {
+    const int S = s_hr_scale;
+    if (S <= 1 || s_hiw || s_selected_bank_tex) return 0;
+    if (((tp >> 7) & 3) != 2) return 0;                  /* 15-bit page */
+    if (s_tw_mask_x | s_tw_mask_y) return 0;             /* no texture window */
+    if (u1 - u0 != w || v1 - v0 != h || u1 > 256 || v1 > 256) return 0;   /* 1:1 */
+    int sx = (tp & 0xF) * 64 + u0, sy = ((tp >> 4) & 1) * 256 + v0;
+    if (sx + w > VRAM_W || sy + h > VRAM_H) return 0;
+    if (sx > s_area_x2 || sx + w - 1 < s_area_x1 ||
+        sy > s_area_y2 || sy + h - 1 < s_area_y1) return 0;
+    flush_cpu_upload();
+    flush_flat_batch();
+    flush_tex_batch();
+    int cw = w * S, ch = h * S;
+    if (!s_fbfb_tex || cw > s_fbfb_w || ch > s_fbfb_h) {
+        if (s_fbfb_tex) glDeleteTextures(1, &s_fbfb_tex);
+        if (cw > s_fbfb_w) s_fbfb_w = cw;
+        if (ch > s_fbfb_h) s_fbfb_h = ch;
+        s_fbfb_tex = make_tex(GL_RGBA8, s_fbfb_w, s_fbfb_h, GL_RGBA, GL_UNSIGNED_BYTE);
+    }
+    p_glActiveTexture(PSXGL_TEXTURE0 + 4);
+    glBindTexture(GL_TEXTURE_2D, s_fbfb_tex);
+    p_glBindFramebuffer(PSXGL_READ_FRAMEBUFFER, s_hr_fbo);
+    glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, sx * S, sy * S, cw, ch);
+    p_glBindFramebuffer(PSXGL_READ_FRAMEBUFFER, 0);
+    p_glActiveTexture(PSXGL_TEXTURE0);
+    p_glUseProgram(s_tex_prog);
+    p_glUniform4i(s_uFbOrg, sx * S, sy * S, S, 0);
+    p_glUniform1i(s_uFb, 1);
+    p_glUseProgram(0);
+    s_fbfb_live = 1;
+    return 1;
+}
+static void fbfb_end(void) {
+    flush_tex_batch();
+    p_glUseProgram(s_tex_prog);
+    p_glUniform1i(s_uFb, 0);
+    p_glUseProgram(0);
+    s_fbfb_live = 0;
+}
+
 static void gpu_textured_rect(int x,int y,int w,int h,
                               int u0,int v0,int u1,int v1,
                               uint16_t clut_x,uint16_t clut_y,uint16_t tp,int semi) {
@@ -4971,6 +5043,7 @@ static void gpu_textured_rect(int x,int y,int w,int h,
      * from the original corners, then the mirror bump (see gpu_uv.h). */
     int lim[4];
     psx_uv_rect_limits(u0, v0, u1, v1, lim);
+    int fb = fbfb_begin(w, h, u0, v0, u1, v1, tp);
     psx_uv_rect_mirror_offset(&u0, &v0, &u1, &v1);
     int xs1[3]={x, x+w, x},    ys1[3]={y, y, y+h};
     int us1[3]={u0,u1,u0},     vs1[3]={v0,v0,v1};
@@ -4978,6 +5051,7 @@ static void gpu_textured_rect(int x,int y,int w,int h,
     int xs2[3]={x+w, x, x+w},  ys2[3]={y, y+h, y+h};
     int us2[3]={u1,u0,u1},     vs2[3]={v0,v1,v1};
     gpu_textured_triangle(xs2,ys2,us2,vs2,col,tp,clut_x,clut_y,s_mod_raw,semi,lim);
+    if (fb) fbfb_end();
 }
 
 /* GP0(02h) fill: writes color with bit15=0, ignoring draw area, mask and
@@ -5827,6 +5901,8 @@ static void free_hr_targets(void) {
     if (s_hr_tex)      { glDeleteTextures(1, &s_hr_tex); s_hr_tex = 0; }
     if (s_scratch_tex) { glDeleteTextures(1, &s_scratch_tex); s_scratch_tex = 0; }
     s_scratch_w = s_scratch_h = 0;
+    if (s_fbfb_tex) { glDeleteTextures(1, &s_fbfb_tex); s_fbfb_tex = 0; }
+    s_fbfb_w = s_fbfb_h = 0;
 }
 
 /* Allocate the authoritative hr surface at scale S. Returns 1 when every
@@ -6004,6 +6080,9 @@ static int init_gpu_raster(void) {
     s_uAuxRect  = p_glGetUniformLocation(s_tex_prog, "u_aux_rect");
     s_uAuxGeom  = p_glGetUniformLocation(s_tex_prog, "u_aux_geom");
     s_uAuxShift = p_glGetUniformLocation(s_tex_prog, "u_aux_shift");
+    s_uFb       = p_glGetUniformLocation(s_tex_prog, "u_fb");
+    s_uFbTex    = p_glGetUniformLocation(s_tex_prog, "u_fb_tex");
+    s_uFbOrg    = p_glGetUniformLocation(s_tex_prog, "u_fb_org");
     s_uBlitSrc     = p_glGetUniformLocation(s_blit_prog, "u_src");
     s_uBlitPass    = p_glGetUniformLocation(s_blit_prog, "u_stp_pass");
     s_uBlitMaskset = p_glGetUniformLocation(s_blit_prog, "u_maskset");
