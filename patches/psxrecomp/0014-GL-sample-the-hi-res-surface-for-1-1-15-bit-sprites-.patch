From 30733c50193618cc6b0dbd3b84d18809482c87ca Mon Sep 17 00:00:00 2001
From: riotashley81-jpg <riotashley81@gmail.com>
Date: Sun, 11 Oct 2026 21:46:41 +0200
Subject: [PATCH 14/17] GL: sample the hi-res surface for 1:1 15-bit sprites
 that read the frame being drawn

Vagrant Story's menu crossfade redraws the frame it just rendered, darkened,
every frame. Reading it back through the packed 1x VRAM snapped flat areas of
the undithered hi-res image to one 5-bit step, so the fade broke into black
blotches. Such sprites now sample a copy of the hr surface (canonical pass
only).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 runtime/src/gpu_gl_renderer.c | 81 ++++++++++++++++++++++++++++++++++-
 1 file changed, 80 insertions(+), 1 deletion(-)

diff --git a/runtime/src/gpu_gl_renderer.c b/runtime/src/gpu_gl_renderer.c
index 0b1989d3..0d36f298 100644
--- a/runtime/src/gpu_gl_renderer.c
+++ b/runtime/src/gpu_gl_renderer.c
@@ -797,6 +797,10 @@ static GLint s_uPalette = -1;
 static GLint s_uRaw = -1, s_uSemipass = -1, s_uSemimode = -1;
 static GLint s_uMaskset = -1, s_uFilter = -1;
 static GLint s_uAux = -1, s_uAuxTex = -1, s_uAuxRect = -1, s_uAuxGeom = -1, s_uAuxShift = -1;
+/* Hi-res framebuffer feedback (local patch, see fbfb_begin). */
+static GLint s_uFb = -1, s_uFbTex = -1, s_uFbOrg = -1;
+static GLuint s_fbfb_tex = 0;
+static int s_fbfb_w = 0, s_fbfb_h = 0, s_fbfb_live = 0;
 static GLint s_uLimits = -1;
 /* Native-wide x-projection uniforms (per program). u_xoff = x translation in
  * native px (0 canonical), u_xhalf = x clip half-extent in native px (512
@@ -1955,6 +1959,12 @@ static const char *TEX_FS =
     "uniform ivec4 u_aux_rect; /* canonical x0, y0, x1, y1 (exclusive) */\n"
     "uniform ivec4 u_aux_geom; /* wide OFFSET, wide width, surface scale, - */\n"
     "uniform int u_aux_shift;  /* texel x shift of this copy */\n"
+    "/* Hi-res framebuffer feedback (local patch): a 1:1 15-bit sprite that\n"
+    "   reads rendered pixels samples a copy of the hr surface instead of the\n"
+    "   packed 1x VRAM, so fades keep their resolution and colour depth. */\n"
+    "uniform int u_fb;         /* 1: sample u_fb_tex */\n"
+    "uniform sampler2D u_fb_tex;\n"
+    "uniform ivec4 u_fb_org;   /* copy origin in hr px, surface scale, - */\n"
     "int vram_at(int x, int y){\n"
     "  ivec2 p = ivec2(x & 1023, y & 511);\n"
     "  if (any(greaterThanEqual(p, textureSize(u_vram, 0)))) return 0;\n"
@@ -2073,6 +2083,14 @@ static const char *TEX_FS =
     "    if (raw == 0) discard;\n"
     "    rgb = col5(raw);\n"
     "    stp = (raw >> 15) & 1;\n"
+    "  } else if (u_fb == 1 && v_depth == 2) {\n"
+    "    ivec2 hp = ivec2(floor((vec2(v_tpage) + uv) * float(u_fb_org.z))) - u_fb_org.xy;\n"
+    "    vec4 a = texelFetch(u_fb_tex, clamp(hp, ivec2(0), textureSize(u_fb_tex, 0) - 1), 0);\n"
+    "    ivec3 c5 = ivec3(a.rgb * 255.0 + 0.5) >> 3;   /* as PACK_FS */\n"
+    "    int raw = c5.r | (c5.g << 5) | (c5.b << 10) | (a.a >= 0.5 ? 0x8000 : 0);\n"
+    "    if (raw == 0) discard;\n"
+    "    rgb = a.rgb;\n"
+    "    stp = (raw >> 15) & 1;\n"
     "  } else if (v_hd_mode != 0) {\n"
     "    vec4 hd=hd_texel(uv);\n"
     "    rgb=hd.rgb;\n"
@@ -2134,7 +2152,7 @@ static const char *TEX_FS =
     "                + float((c01 >> 15) & 1) * w01 + float((c11 >> 15) & 1) * w11) / opac;\n"
     "    stp = stpf >= 0.5 ? 1 : 0;\n"
     "  }\n"
-    "  if ((u_filter & 16) != 0 && v_hd_mode == 0 && u_aux == 0) rgb = lod_sample(uv0, dx0, dy0, stp, rgb);\n"
+    "  if ((u_filter & 16) != 0 && v_hd_mode == 0 && u_aux == 0 && u_fb == 0) rgb = lod_sample(uv0, dx0, dy0, stp, rgb);\n"
     "  if (u_semipass == 1 && stp == 1) discard;\n"
     "  if (u_semipass == 2 && stp == 0) discard;\n"
