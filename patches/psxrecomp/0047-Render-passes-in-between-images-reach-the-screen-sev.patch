+/* A title's hook run before each scheduled present of a source interval
+ * (psx_mod_set_render_pass_present_hook): late passes whose input arrives
+ * between two presents of one interval join before the second. While it
+ * runs, presents are not serviced from inside its passes (the loop below
+ * owns the schedule) and the slack is to the present about to be made. */
+static void (*s_pre_present_hook)(void);
+static int s_in_pre_present;
+static double s_pre_present_deadline;
+void gl_renderer_pass_set_present_hook(void (*fn)(void)) {
+    GL_RT_SYNC("pass_set_present_hook");
+    s_pre_present_hook = fn;
+}
+static void pass_run_present_hook(uint64_t deadline) {
+    if (!s_pre_present_hook || s_in_pre_present || s_pass_active) return;
+    s_in_pre_present = 1;
+    s_pre_present_deadline = (double)deadline;
+    s_pre_present_hook();
+    s_in_pre_present = 0;
+}
+
+double gl_renderer_pass_present_slack_ms(void) {
+    GL_RT_SYNC("pass_present_slack");
+    const double d = s_in_pre_present ? s_pre_present_deadline
+                                      : s_interp_schedule.next_present_deadline;
+    const double now = (double)SDL_GetPerformanceCounter();
+    if (!gl_renderer_pass_ready() || !(d > 0.0)) return 0.0;
+    return d > now ? (d - now) * 1000.0 / (double)SDL_GetPerformanceFrequency() : 0.0;
+}
