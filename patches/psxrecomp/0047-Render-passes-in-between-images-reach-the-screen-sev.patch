+/* Output deadlines just before the frame's VBlank boundaries (the presenter
+ * locked to the display refresh): the one at the frame's end shows the next
+ * game frame, so 60 presents/s plan the middle only, never phase 0.998. */
+static void test_frame_end_deadline(void) {
+    RenderPassPlanInput in = {0};
+    uint32_t a[RENDER_PASS_MAX_PHASES], wanted = 0, n;
+    in.frame_start = 1e12;
+    in.frame_length = 2.0 * 1e9 / 60.0;
+    in.target_period = 1e9 / 60.0;
+    in.next_deadline = in.frame_start - 50000.0;   /* 50 us early */
+    in.budget = -1.0;
+    in.max = RENDER_PASS_MAX_PHASES;
+    n = render_pass_plan_phases(&in, a, &wanted);
+    CHECK(n == 1 && wanted == 1, "60 on a 30 Hz frame: one in-between");
+    CHECK(n == 1 && fabs(a[0] / 65536.0 - 0.5) < 0.01, "it is the middle");
+    in.max = 1;
+    in.budget = 1e9;
+    in.pass_cost = 1e6;
+    n = render_pass_plan_phases(&in, a, NULL);
+    CHECK(n == 1 && fabs(a[0] / 65536.0 - 0.5) < 0.01, "a one-pass budget keeps the middle");
+}
